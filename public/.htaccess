# Namecheap / cPanel (Apache) settings for this React site.
# Copied into dist/ by Vite — upload it together with the other files.

# 1) Single-page app: send every page address (/about, /project/…) to index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# 2) Cache the hashed JS/CSS files for a long time (they get new names on every build),
#    but always re-check index.html so visitors get the newest version.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|png|jpg|jpeg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
